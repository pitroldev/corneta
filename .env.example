# Never commit real credentials. Contributor commands do not require this file.
# Variable loading and provider setup: docs/CONFIGURACAO.md.

# Twitch requires a Public client; the device flow does not use a client secret.
VITE_TWITCH_CLIENT_ID=

# Google requires a Desktop OAuth client for PKCE/loopback, not a TV/device client.
VITE_GOOGLE_CLIENT_ID=
# The Setup API must use the same public client ID as the desktop.
GOOGLE_CLIENT_ID=

# Kick's redirect URI is exactly http://localhost:7395/callback.
VITE_KICK_CLIENT_ID=
# Server-only: never embed this secret in the desktop bundle.
KICK_CLIENT_SECRET=

# Required HTTPS origin in release; development defaults to http://localhost:7390.
VITE_SETUP_API_URL=

# Public ingestion token only; never put a Personal API Key in VITE_*.
# An empty token or host disables collection. See docs/CONFIGURACAO.md for consent policy.
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_BUILD_SHA=
# 1 prevents SDK initialization and requests.
VITE_TELEMETRY_DISABLED=0

# Native build allowlist; use the same project, host, SHA and kill switch as the desktop.
POSTHOG_DESKTOP_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
CORNETA_BUILD_SHA=
TELEMETRY_DISABLED=0

# Release tokens and full commit SHAs must match the desktop configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_BUILD_SHA=
BUILD_SHA=

# CI only: project-scoped Personal API Key with error_tracking:write and project:read.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
