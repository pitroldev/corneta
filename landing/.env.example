NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
NEXT_PUBLIC_PRIMARY_CTA_URL=

# OAuth server-only. Em desenvolvimento, o Next também reconhece os nomes
# VITE_* já presentes no `.env` da raiz. Em produção, prefira estes nomes.
TWITCH_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Opcional. Se vazio, o broker deriva uma chave dos Client Secrets existentes.
# Use um valor aleatório dedicado em produção (mínimo recomendado: 32 bytes).
OAUTH_BROKER_SECRET=

# Lista separada por vírgula. O padrão preserva o callback atual do desktop.
KICK_REDIRECT_URIS=http://localhost:7395/callback
