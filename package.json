{
  "name": "corneta",
  "private": true,
  "version": "0.12.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11 <12"
  },
  "description": "Corneta — stream to multiple platforms from your desktop.",
  "type": "module",
  "scripts": {
    "contrib:demo": "node scripts/contributor.mjs demo",
    "contrib:web": "node scripts/contributor.mjs web",
    "contrib:check": "node scripts/contributor.mjs check",
    "contrib:web:check": "node scripts/contributor.mjs web:check",
    "contrib:app:dev": "node scripts/contributor.mjs app:dev",
    "contrib:app:build": "node scripts/contributor.mjs app:build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:fast": "vite build",
    "build": "pnpm typecheck && pnpm build:fast",
    "build:release": "pnpm build && pnpm bundle:check",
    "bundle:check": "node scripts/check-bundle.mjs",
    "benchmark:build": "node scripts/benchmark-build.mjs",
    "smoke:reports": "node scripts/smoke-reports.mjs",
    "artifacts:check": "node scripts/check-bundle.mjs dist src-tauri/target/release/corneta.exe src-tauri/target/release/bundle",
    "updater:manifest": "node scripts/create-updater-manifest.mjs",
    "release:readiness": "node scripts/check-release-readiness.mjs",
    "compliance:check": "node scripts/prepare-release-compliance.mjs --check",
    "compliance:prepare": "node scripts/prepare-release-compliance.mjs",
    "compliance:collect": "node scripts/collect-ffmpeg-evidence.mjs",
    "compliance:collect:offline": "node scripts/collect-ffmpeg-evidence.mjs --offline",
    "web:release:check": "pnpm --dir web release:check",
    "reports:seed": "node scripts/seed-report-fixtures.mjs",
    "reports:fixtures:clean": "node scripts/seed-report-fixtures.mjs --clean",
    "reports:fixtures:restore": "node scripts/seed-report-fixtures.mjs --restore",
    "telemetry:release:check": "node scripts/check-telemetry-release.mjs",
    "lint": "eslint src scripts *.config.js *.config.ts --max-warnings=0",
    "format": "node scripts/check-format.mjs --write",
    "format:check": "node scripts/check-format.mjs",
    "check:app": "pnpm lint && pnpm scripts:check && pnpm docs:check && pnpm format:check && pnpm test && pnpm build && pnpm bundle:check",
    "check": "pnpm check:app && pnpm web:check",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "node scripts/with-env.mjs tauri dev",
    "app:build": "node scripts/with-env.mjs tauri build",
    "installer:art": "pwsh -NoProfile -File scripts/make-installer-art.ps1",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:check": "pnpm --dir web check",
    "bump": "node scripts/bump.mjs",
    "benchmark:reports": "node web/node_modules/tsx/dist/cli.mjs scripts/benchmark-reports.ts",
    "benchmark:telemetry": "node scripts/benchmark-telemetry.mjs",
    "benchmark:replay": "node scripts/benchmark-replay.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "scripts:check": "node scripts/check-scripts.mjs",
    "source:check": "node scripts/check-source-language.mjs",
    "format:all": "node scripts/check-format.mjs --all --write"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.57.0",
    "posthog-js": "1.438.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@posthog/plugin-utils": "2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pitroldev/corneta.git"
  },
  "homepage": "https://www.corneta.live",
  "bugs": {
    "url": "https://github.com/pitroldev/corneta/issues"
  }
}
