{
  "name": "corneta",
  "private": true,
  "version": "0.6.4",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11 <12"
  },
  "description": "Corneta — transmita para todas as plataformas ao mesmo tempo, sem dor de cabeça.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "pnpm build && pnpm bundle:check",
    "bundle:check": "node scripts/check-bundle.mjs",
    "artifacts:check": "node scripts/check-bundle.mjs dist src-tauri/target/release/corneta.exe src-tauri/target/release/bundle",
    "updater:manifest": "node scripts/create-updater-manifest.mjs",
    "telemetry:release:check": "node scripts/check-telemetry-release.mjs",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/check-bundle.mjs\" \"scripts/check-telemetry-release.mjs\" \"scripts/create-updater-manifest.mjs\" \"docs/**/*.md\" \".github/workflows/*.{yml,yaml}\" \"vite.config.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/check-bundle.mjs\" \"scripts/check-telemetry-release.mjs\" \"scripts/create-updater-manifest.mjs\" \"docs/**/*.md\" \".github/workflows/*.{yml,yaml}\" \"vite.config.ts\" \"*.{json,md}\"",
    "check:app": "pnpm lint && pnpm test && pnpm build && pnpm bundle:check",
    "check": "pnpm check:app && pnpm web:check",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "node scripts/with-env.mjs tauri dev",
    "app:build": "node scripts/with-env.mjs tauri build",
    "installer:art": "pwsh -NoProfile -File scripts/make-installer-art.ps1",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:check": "pnpm --dir web check",
    "bump": "node scripts/bump.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "posthog-js": "^1.417.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@posthog/rollup-plugin": "^1.4.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
