{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corneta",
  "version": "0.1.0",
  "identifier": "br.com.growthedge.corneta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Corneta",
        "width": 1080,
        "height": 720,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "_comment_externalBin": "Descomente após rodar scripts/fetch-binaries.ps1 (baixa ffmpeg/mediamtx com o sufixo do target-triple). Ver §14.1 do PLANEJAMENTO.md.",
    "externalBin": []
  }
}
