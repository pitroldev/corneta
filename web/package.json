{
  "name": "@corneta/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pitroldev/corneta.git",
    "directory": "web"
  },
  "homepage": "https://www.corneta.live",
  "bugs": {
    "url": "https://github.com/pitroldev/corneta/issues"
  },
  "scripts": {
    "dev": "next dev --port 7390",
    "build": "next build",
    "release:check": "tsx scripts/check-release-config.ts",
    "build:release": "pnpm content:maintenance:check && pnpm release:check && pnpm build",
    "start": "next start",
    "content:check": "tsx scripts/check-editorial-content.ts",
    "content:maintenance": "tsx scripts/check-editorial-maintenance.ts",
    "content:maintenance:check": "tsx scripts/check-editorial-maintenance.ts --fail-on-overdue",
    "content:revision:check": "tsx scripts/check-editorial-revisions.ts",
    "content:impact:declare": "tsx scripts/declare-source-impact.ts",
    "content:image": "tsx scripts/optimize-editorial-image.ts",
    "prebuild": "node scripts/check-build-content.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contributor": "node ../scripts/contributor.mjs web:check",
    "check": "pnpm content:check && pnpm lint && pnpm typecheck && pnpm build && node scripts/check-build-routes.mjs"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-mdx-remote": "6.0.0",
    "posthog-js": "^1.438.10",
    "posthog-node": "^5.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.1",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  }
}
