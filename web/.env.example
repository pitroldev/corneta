# Production metadata requires the official canonical origin.
NEXT_PUBLIC_SITE_URL=https://www.corneta.live
# Placeholder for non-release builds; official releases require an approved .exe URL.
NEXT_PUBLIC_PRIMARY_CTA_URL=https://example.com/corneta-download

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

TWITCH_CLIENT_ID=
GOOGLE_CLIENT_ID=
KICK_CLIENT_ID=
# Server only: never expose this secret through VITE_* or NEXT_PUBLIC_*.
KICK_CLIENT_SECRET=

# Exact, comma-separated callback allowlist; no wildcards.
KICK_REDIRECT_URIS=http://localhost:7395/callback

# Vercel selects its protected header automatically. Self-hosted proxies must
# overwrite this header and prevent direct public access to the origin.
OAUTH_TRUSTED_IP_HEADER=
# Official gates run automatically on Vercel production; use 1 on other release hosts.
CORNETA_RELEASE_CHECK=0

# Ingestion project token only; never expose a Personal API Key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_TELEMETRY_DISABLED=0
NEXT_PUBLIC_DEPLOYMENT_ENV=development
# Full 40-character commit SHA, matching the deployed Setup API.
NEXT_PUBLIC_BUILD_SHA=

# Server overrides take precedence over matching NEXT_PUBLIC_* fallbacks.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
TELEMETRY_DISABLED=0
POSTHOG_ENVIRONMENT=development
# Full commit SHA, equal to NEXT_PUBLIC_BUILD_SHA in production.
BUILD_SHA=
