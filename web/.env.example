# URL canônica, com o mesmo host registrado no Google Cloud e no Search Console.
# Sem ela o build em CI/Vercel falha de propósito: sitemap, canonical e dados
# estruturados sairiam apontando para localhost.
NEXT_PUBLIC_SITE_URL=https://www.corneta.live
NEXT_PUBLIC_PRIMARY_CTA_URL=https://example.com/corneta-download

# OAuth server-only. Em desenvolvimento, o Next também reconhece os nomes
# VITE_* já presentes no `.env` da raiz. Em produção, prefira estes nomes.
TWITCH_CLIENT_ID=
GOOGLE_CLIENT_ID=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Lista separada por vírgula. O padrão preserva o callback atual do desktop.
KICK_REDIRECT_URIS=http://localhost:7395/callback

# Telemetria cookieless do site. O token `phc_*` é somente o Project API Key
# de ingestão; nunca coloque uma PostHog Personal API Key em variável pública.
# Sem token/host válidos, ou com o kill switch em 1, o facade vira no-op. Em
# produção, use o mesmo project token `phc_*` da Setup API e o host US abaixo.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_TELEMETRY_DISABLED=0
NEXT_PUBLIC_DEPLOYMENT_ENV=development
# SHA completo (40 caracteres) do mesmo commit implantado na Setup API.
NEXT_PUBLIC_BUILD_SHA=

# Telemetria server-only das falhas da Setup API e de render do Next.js.
# Pode usar o mesmo Project API Key de ingestão; `POSTHOG_*` prevalece sobre
# o fallback `NEXT_PUBLIC_*`. Vercel fornece VERCEL_ENV e
# VERCEL_GIT_COMMIT_SHA automaticamente quando os overrides abaixo ficam vazios.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
TELEMETRY_DISABLED=0
POSTHOG_ENVIRONMENT=development
# SHA completo (40 caracteres), igual a NEXT_PUBLIC_BUILD_SHA na produção.
BUILD_SHA=
